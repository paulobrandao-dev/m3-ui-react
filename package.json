{
  "name": "m3-ui-react",
  "version": "2.0.0",
  "type": "module",
  "license": "ISC",
  "homepage": "https://paulobrandao-dev.github.io/m3-ui-react",
  "author": {
    "name": "Paulo Brandão",
    "url": "https://github.com/paulobrandao-dev",
    "email": "paulobrandao.dev@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulobrandao-dev/m3-ui-react.git"
  },
  "bugs": {
    "url": "https://github.com/paulobrandao-dev/m3-ui-react/issues"
  },
  "files": [
    "dist",
    "badges.svg"
  ],
  "main": "./dist/m3-ui.js",
  "module": "./dist/m3-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/m3-ui.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./icon/outlined": {
      "types": "./dist/icon/outlined.d.ts",
      "import": "./dist/icon-outlined.js"
    },
    "./icon/rounded": {
      "types": "./dist/icon/rounded.d.ts",
      "import": "./dist/icon-rounded.js"
    },
    "./icon/sharp": {
      "types": "./dist/icon/sharp.d.ts",
      "import": "./dist/icon-sharp.js"
    },
    "./font": {
      "types": "./dist/components/font.d.ts",
      "import": "./dist/font.js"
    },
    "./dist/m3-ui.css": {
      "import": "./dist/m3-ui.css"
    },
    "./dist/icon-outlined.css": {
      "import": "./dist/icon-outlined.css"
    },
    "./dist/icon-rounded.css": {
      "import": "./dist/icon-rounded.css"
    },
    "./dist/icon-sharp.css": {
      "import": "./dist/icon-sharp.css"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build:docs": "tsc -b && vite build -c configs/vite.config.docs.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --coverage.enabled=true --ui",
    "coverage": "vitest run --coverage",
    "make-badges": "coverage-badges --output ./badges.svg",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint",
      "prettier --write --config .prettierrc.json"
    ],
    "*.{scss,css}": "prettier --write --config .prettierrc.json"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "clsx": "^2.1.1",
    "material-symbols": "^0.47.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "coverage-badges-cli": "^2.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "rollup-preserve-directives": "^1.1.3",
    "sass": "^1.104.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^5.0.0"
  }
}
